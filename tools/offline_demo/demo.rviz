Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Cell Size: 1
      Plane Cell Count: 20
      Color: 160; 160; 164
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Marker Scale: 0.6
      Show Names: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: PointCloud2_RAW
      Topic:
        Value: /utlidar/cloud_deskewed
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 3
      Color Transformer: AxisColor
      Axis: Z
      Position Transformer: XYZ
      Queue Size: 10
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: LaserScan_2D
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
      Style: Points
      Size (m): 0.03
      Color: 255; 60; 60
      Color Transformer: FlatColor
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: Map
      Topic:
        Value: /map
      Color Scheme: map
      Alpha: 0.7
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: Odometry
      Topic:
        Value: /odom
      Keep: 1
  Global Options:
    Fixed Frame: map
    Background Color: 48; 48; 48
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 14
      Focal Point:
        X: 0
        Y: 0
        Z: 0.5
      Pitch: 0.95
      Yaw: 0.7
  Window Geometry:
    Height: 980
    Width: 1580
